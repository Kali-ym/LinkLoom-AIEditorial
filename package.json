{
  "name": "linkloom",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=11.5.1"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev:backend": "tsx --watch backend/src/index.ts",
    "dev:admin": "pnpm --filter ./admin run dev",
    "dev:web": "pnpm --filter ./web run dev",
    "dev:console": "pnpm --filter ./agent-console run dev",
    "dev:all": "concurrently \"SKIP_NEXT_SPAWN=1 pnpm run dev:backend\" \"pnpm run dev:admin\" \"pnpm run dev:web\" \"pnpm run dev:console\" --names \"backend,admin,web,console\" --prefix-colors \"blue,green,magenta,cyan\"",
    "build": "node backend/scripts/clean-dist.js && tsc -p tsconfig.json && node backend/scripts/copy-assets.js",
    "build:backend": "node backend/scripts/clean-dist.js && tsc -p tsconfig.json && node backend/scripts/copy-assets.js",
    "build:admin": "pnpm --filter ./admin run build",
    "build:web": "pnpm --filter ./web run build",
    "build:console": "pnpm --filter ./agent-console run build",
    "build:all": "turbo run build",
    "serve": "node backend/dist/index.js",
    "prod": "pnpm run build:all && pnpm run serve",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:admin": "pnpm --filter ./admin exec tsc --noEmit",
    "typecheck:web": "pnpm --filter ./web exec tsc --noEmit",
    "typecheck:console": "pnpm --filter ./agent-console exec tsc --noEmit",
    "typecheck:all": "turbo run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:admin": "pnpm --filter ./admin run lint",
    "lint:web": "pnpm --filter ./web run lint",
    "lint:console": "pnpm --filter ./agent-console run lint",
    "lint:all": "turbo run lint",
    "format": "prettier --write \"backend/src/**/*.{ts,tsx,js,mjs,json}\" \"scripts/**/*.{js,mjs}\" \"e2e/**/*.ts\" \"docs/**/*.md\" \"*.{json,md,yaml,yml}\"",
    "format:check": "prettier --check \"backend/src/**/*.{ts,tsx,js,mjs,json}\" \"scripts/**/*.{js,mjs}\" \"e2e/**/*.ts\" \"docs/**/*.md\" \"*.{json,md,yaml,yml}\"",
    "check:encoding": "node scripts/check-encoding.js",
    "check:maintainability": "node scripts/check-maintainability.js",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "release": "pnpm run ci && changeset publish",
    "test:repositories": "pnpm run build:backend && node backend/scripts/test-repositories.mjs",
    "test:api-smoke": "pnpm run build:backend && node backend/scripts/test-api-smoke.mjs",
    "verify:rag-production": "node backend/scripts/verify-rag-production.mjs",
    "test:rag-eval-ci": "vitest run backend/tests/rag-route-service.test.ts --reporter=json",
    "test:rag-verification-matrix": "vitest run backend/tests/knowledge-retrieval-service.test.ts backend/tests/knowledge-query-contract.test.ts backend/tests/rag-route-service.test.ts backend/tests/rag-embedding-jobs.test.ts backend/tests/rag-query-planner.test.ts backend/tests/query-tools.test.ts backend/tests/workflow-agent-runtime.test.ts",
    "test:route-services": "pnpm run build:backend && node backend/scripts/test-route-services.mjs",
    "test:workflow-runtime": "pnpm run build:backend && node backend/scripts/test-workflow-runtime.mjs",
    "test:ai-builder": "pnpm run build:backend && node backend/scripts/test-ai-builder.mjs",
    "test:agent-engine": "pnpm run build:backend && node backend/scripts/test-agent-engine.mjs",
    "test:agent-platform": "pnpm run build:backend && node backend/scripts/test-agent-platform.mjs",
    "test:eval-harness": "pnpm run test:agent-engine && pnpm run test:agent-platform",
    "test:backend-smoke": "pnpm run test:repositories && pnpm run test:api-smoke && pnpm run test:route-services && pnpm run test:workflow-runtime",
    "test:admin-workflow-utils": "pnpm --filter ./admin run test:workflow-utils",
    "test": "pnpm run test:backend-smoke && pnpm run test:ai-builder && pnpm run test:eval-harness && pnpm run test:unit",
    "test:unit": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:all": "pnpm run test:backend-smoke && pnpm run test:ai-builder && pnpm run test:eval-harness && pnpm run test:admin-workflow-utils && pnpm run test:unit",
    "ci": "pnpm run format:check && pnpm run check:encoding && pnpm run check:maintainability && pnpm run typecheck:all && pnpm run lint:all && pnpm run test:all && pnpm run build:all",
    "db:stats": "pnpm run build:backend && node backend/scripts/db-stats.mjs",
    "db:vacuum": "pnpm run build:backend && node backend/scripts/db-vacuum.mjs",
    "db:archive": "pnpm run build:backend && node backend/scripts/db-archive.mjs",
    "db:retention": "pnpm run build:backend && node backend/scripts/db-retention.mjs",
    "doctor:data": "pnpm run build:backend && node backend/scripts/doctor-data.mjs",
    "backup:data": "pnpm run build:backend && node backend/scripts/backup-data.mjs",
    "restore:data": "pnpm run build:backend && node backend/scripts/restore-data.mjs",
    "rebuild:native": "pnpm rebuild sharp",
    "deploy:docker": "bash deploy/docker-deploy.sh",
    "deploy:postgres-migrate": "bash deploy/postgres-migrate.sh",
    "deploy:stack-migrate": "bash deploy/stack-migrate.sh",
    "deploy:agent-image": "bash deploy/scripts/build-agent-image.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.990.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/reply-from": "^12.6.2",
    "@fastify/static": "^9.0.0",
    "@langchain/anthropic": "^1.3.26",
    "@langchain/core": "^1.1.39",
    "@langchain/google-genai": "^2.1.26",
    "@langchain/ollama": "^1.2.6",
    "@langchain/openai": "^1.4.4",
    "@modelcontextprotocol/sdk": "^1.0.1",
    "@octokit/rest": "^22.0.1",
    "@sentry/node": "^10.54.0",
    "adm-zip": "^0.5.16",
    "axios": "^1.13.5",
    "concurrently": "^9.2.1",
    "csv-parse": "^6.2.1",
    "dockerode": "^5.0.0",
    "dotenv": "^17.2.3",
    "fast-xml-parser": "^5.8.0",
    "fastify": "^5.7.2",
    "fs-extra": "^11.3.3",
    "gpt-tokenizer": "^3.4.0",
    "mammoth": "^1.12.0",
    "mime-types": "^3.0.2",
    "node-cron": "^4.2.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.13.0",
    "rss": "^1.2.2",
    "rss-parser": "^3.13.0",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "typeid-js": "^1.2.0",
    "typescript": "^5.9.3",
    "undici": "^7.22.0",
    "xlsx": "npm:@e965/xlsx@^0.20.3",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.60.0",
    "@types/adm-zip": "^0.5.7",
    "@types/dockerode": "^4.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^25.1.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.11.0",
    "@types/rss": "^0.0.32",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.5.0",
    "only-allow": "^1.2.1",
    "prettier": "^3.4.2",
    "turbo": "^2.9.15",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.1.7"
  }
}
