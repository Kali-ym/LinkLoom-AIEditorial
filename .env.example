# =============================================================================
# LinkLoom 环境配置
#
# 使用：cp .env.example .env 后按需修改
# 索引：config/README.md  |  高级变量：docs/env.md
# =============================================================================

# =============================================================================
# 1. 安全（生产必填）
# =============================================================================
JWT_SECRET=change-me-long-random-string
AI_BUILDER_POLICY_SECRET=change-me-another-secret
SYSTEM_PASSWORD=change-me-admin-password

# =============================================================================
# 2. 对外访问（浏览器实际打开的地址）
# =============================================================================
# 局域网示例：http://192.168.1.10:3000
PUBLIC_ORIGIN=http://127.0.0.1:3000
# Agent Console 跨域：* 或留空 = 允许任意 Origin（推荐独立 Console）；也可逗号白名单
# 例：CORS_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:5174
CORS_ORIGINS=*
# 独立 Console 公网地址（可选）。设置后访问 /console 与旧 /admin/agents/console 会 302 到此 URL
# CONSOLE_PUBLIC_URL=http://127.0.0.1:5174/console

# =============================================================================
# 3. HTTP 服务
# =============================================================================
NODE_ENV=production
PORT=3000
LISTEN_HOST=0.0.0.0
# Docker Compose 宿主机端口映射（host:container 左侧）
HOST_PUBLISH=0.0.0.0:3000

# =============================================================================
# 4. 前端构建（admin；agent-console 独立托管）
#    本地 vite build 直接读根 .env；Docker 构建经 build-arg 注入（.env 不进镜像层）
# =============================================================================
# VITE_API_BASE_URL：admin 构建期 API 基址，留空则同源
VITE_API_BASE_URL=
# VITE_AGENT_CONSOLE_DATA：本地开发 console 数据模式：api(默认) | mock(离线演示)
VITE_AGENT_CONSOLE_DATA=api

# =============================================================================
# 5. PostgreSQL
# =============================================================================
# 本机直跑：localhost；Docker Compose：docker-deploy.sh 会自动改为 postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=linkloom
POSTGRES_PASSWORD=linkloom
POSTGRES_DB=linkloom
# 宿主机暴露 Postgres（仅本机：127.0.0.1:5432；局域网：0.0.0.0:5432）
POSTGRES_PUBLISH=127.0.0.1:5432
# 也可直接写完整连接串（设置后优先于上方 POSTGRES_*）
# DATABASE_URL=postgres://linkloom:linkloom@localhost:5432/linkloom

# =============================================================================
# 6. 内置 Next 子进程（读者站）
# =============================================================================
NEXT_PORT=3100
SKIP_NEXT_SPAWN=0

# =============================================================================
# 7. 本地数据目录
# =============================================================================
DATA_DIR=./data
BACKUP_DIR=./backups

# =============================================================================
# 8. Docker 镜像构建（仅 ./deploy/docker-deploy.sh 构建阶段生效）
# =============================================================================
# 机器档位：low(2GB) | normal(8GB) | high(16GB+) | auto(按内存自动)
# 换机器时改这一行即可
DOCKER_BUILD_PROFILE=low
# 精确覆盖档位（单位 MB，设置后优先于 DOCKER_BUILD_PROFILE）
# DOCKER_BUILD_NODE_HEAP=1536
# 构建并行度：serial(默认,省内存) | parallel(8GB+ 可试,略快)
# DOCKER_BUILD_PARALLEL=serial
# 构建镜像源（也可命令行 OVERSEAS=1）
# APT_MIRROR=mirrors.aliyun.com
# NPM_REGISTRY=https://registry.npmmirror.com

# =============================================================================
# 9. 可选功能（默认值通常够用，详见 docs/env.md）
# =============================================================================

# --- 联网搜索（web_search 工具）---
# JINA_API_KEY=
# 或在管理后台「系统设置」配置 API_PROXY=http://127.0.0.1:7890

# --- Agent 沙箱 / 工作区 ---
# 两种执行模式（在管理后台「Agent 详情」设置 executionTarget）：
#   sandbox = per-agent Docker 沙箱（OS 级隔离，需挂载 docker.sock，见 docs/gateway/PR1-docker-workspace.md）
#   local   = per-agent 本地工作区（文件级隔离，不挂 docker.sock，默认推荐）
# AGENT_WORKSPACE_ROOT：local 模式工作区根目录；agent run 与 agent-console 共享
#   ${AGENT_WORKSPACE_ROOT}/agents/<agentId> 持久化目录。Docker Compose 部署时设为
#   /app/data（与 DATA_DIR 容器内路径一致），让工作区文件落在宿主机 ./data/agents/<agentId>。
# 本机直跑可留空（默认 os.tmpdir()/linkloom-agent-workspaces，但不会与 agent-console 对齐）。
AGENT_WORKSPACE_ROOT=/app/data
# per-agent Docker 沙箱（仅 executionTarget=sandbox 时需要）：
# LINKLOOM_MAX_SANDBOX_CONTAINERS=10
# LINKLOOM_AGENT_IMAGE=linkloom-agent:demo
# 生产环境在宿主机直接执行 shell 需显式开启；per-agent Docker 沙箱内执行无需此项
# ENABLE_EXECUTE_COMMAND_TOOL=1
