{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Shanghai",
  "schedule": ["before 9am on monday"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "dependencyDashboard": true,
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "groupName": "typescript eslint stack",
      "matchPackageNames": [
        "typescript-eslint",
        "@typescript-eslint/**",
        "eslint",
        "@eslint/js",
        "eslint-*",
        "globals"
      ]
    },
    {
      "groupName": "langchain providers",
      "matchPackageNames": ["@langchain/**"]
    },
    {
      "groupName": "fastify stack",
      "matchPackageNames": ["fastify", "@fastify/**"]
    },
    {
      "groupName": "react stack",
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom",
        "react-router-dom"
      ]
    },
    {
      "groupName": "next stack",
      "matchPackageNames": ["next", "eslint-config-next", "next-themes"]
    },
    {
      "groupName": "vite stack",
      "matchPackageNames": ["vite", "@vitejs/plugin-react"]
    },
    {
      "groupName": "testing stack",
      "matchPackageNames": ["vitest", "@vitest/**", "@playwright/test"]
    },
    {
      "matchPackageNames": ["sharp"],
      "matchUpdateTypes": ["major"],
      "enabled": false,
      "description": "Native dependencies require manual major-version verification."
    }
  ]
}
